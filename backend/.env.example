# Backend Environment Variables Example
# Copy this file to backend/.env for local backend development

# Ollama LLM Engine Configuration
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=-1
OLLAMA_TEMPERATURE=0.7

# PostgreSQL / Neon Database URL
DATABASE_URL="postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication
JWT_SECRET="your_backend_jwt_secret_key_here"

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
