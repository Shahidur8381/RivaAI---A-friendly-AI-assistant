# Root Environment Variables Example
# Copy this file to .env.local or .env for local development

# Database connection strings (Neon / PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Neon Branch
NEON_BRANCH=production

# JWT Authentication Secret (Generate a strong random key in production)
JWT_SECRET="your_strong_jwt_secret_key_here"
