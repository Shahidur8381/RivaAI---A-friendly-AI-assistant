# Riva AI — Docker Production Environment Variables Template (.env)
# Copy this file to .env on your VPS and populate it with your real credentials.

# Ollama Container Endpoint (via Docker network 'riva-network')
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=-1
OLLAMA_TEMPERATURE=0.7

# PostgreSQL / Neon Database Connection String
DATABASE_URL=postgresql://username:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret Key for Session Authentication (Generate a strong random string)
JWT_SECRET=generate-a-strong-random-jwt-secret-key-here

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://ai.shahidur.me,https://riva-ai.netlify.app
